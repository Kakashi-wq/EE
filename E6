#include <WiFi.h>
#include <ThingSpeak.h>

WiFiClient c;

void setup() {
  pinMode(2, OUTPUT);

  WiFi.begin("WIFI_NAME", "PASSWORD");

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
  }

  ThingSpeak.begin(c);
}

void loop() {
  int ldr = analogRead(34);

  int s = (ldr < 2000) ? 1 : 0;

  digitalWrite(2, s);

  ThingSpeak.setField(1, ldr);
  ThingSpeak.setField(2, s);

  ThingSpeak.writeFields(CHANNEL_ID, "API_KEY");

  delay(20000);
}

