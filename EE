#include <Servo.h>

Servo myservo;

void setup() {
  pinMode(2, INPUT);
  myservo.attach(9);
}

void loop() {
  if (digitalRead(2) == LOW) {
    // Object Detected
    myservo.write(90);
  }
  else {
    myservo.write(0);
  }
}

