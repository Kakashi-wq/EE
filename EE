#include <LiquidCrystal.h>
LiquidCrystal lcd(12,11,5,4,3,2);

void setup() {
  pinMode(9, OUTPUT);
  pinMode(10, INPUT);
  lcd.begin(16,2);
}

void loop() {
  digitalWrite(9, LOW);
  delayMicroseconds(2);
  digitalWrite(9, HIGH);
  delayMicroseconds(10);
  digitalWrite(9, LOW);

  float d = pulseIn(10,HIGH)*0.034/2;

  lcd.setCursor(0,0);
  lcd.print("Distance:");
  lcd.setCursor(0,1);
  lcd.print(d);
  lcd.print(" cm");
  delay(500);
}

